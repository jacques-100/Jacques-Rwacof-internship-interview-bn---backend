# Copy to deploy/.env on the server and fill in every value. Never commit the real file.

# Where the API will live (the DNS A record for this name must point at this server).
API_DOMAIN=api.alpharesearchlabs.org
# Where the web app lives. The API only accepts browser calls from here (and from the Android app).
WEB_ORIGIN=https://cherrytrack.alpharesearchlabs.org

# Generate each secret on the server:  openssl rand -base64 36
DB_PASSWORD=
DB_ROOT_PASSWORD=
# At least 32 characters. Changing it later signs everyone out.
JWT_SECRET=

# Creates the 'admin' account on the first start (empty database only). Choose a strong password,
# sign in, change it in My profile, then you may blank this line.
BOOTSTRAP_ADMIN_PASSWORD=
