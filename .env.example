# Copy to .env and fill in. Never commit the real file.
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
# Creates the 'admin' account on an empty database. Choose a strong password, then change it in My profile.
BOOTSTRAP_ADMIN_PASSWORD=
# The Android app (Capacitor) calls from https://localhost (or http://localhost for LAN development builds)
CORS_ALLOWED_ORIGINS=http://localhost:8088,https://localhost
# Set to true when served over HTTPS
REFRESH_COOKIE_SECURE=false
SWAGGER_ENABLED=false
